ANTHROPIC_API_KEY=
# Usa "local" per il fallback gratuito o "anthropic" per la ricostruzione LLM.
OPERATIONAL_MODEL_PROVIDER=anthropic
OPERATIONAL_MODEL_MODEL=claude-sonnet-5
OPERATIONAL_MODEL_EFFORT=medium
OPERATIONAL_MODEL_MAX_TOKENS=8000
SHOPIFY_STORE=your-test-store.myshopify.com
SHOPIFY_TOKEN=

# true abilita i sei scenari portfolio senza chiamate esterne.
DEMO_MODE=true

# Il prototipo usa solo il provider mock e non chiama Sendcloud.
RETURN_SHIPPING_PROVIDER=mock

# Facoltativo. Default: data/returns.db
DATABASE_PATH=
